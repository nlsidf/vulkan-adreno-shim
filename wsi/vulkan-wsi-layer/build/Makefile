# target to generate assembly for a file
xdg-shell-protocol.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/wsi_x11.dir/build.make CMakeFiles/wsi_x11.dir/xdg-shell-protocol.c.s
.PHONY : xdg-shell-protocol.c.s

