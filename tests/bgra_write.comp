#version 450
// 按 BGRA 语义写入: imageStore(img, coord, vec4(B, G, R, A))
// 这里写固定色 B=0.0, G=0.5, R=1.0, A=1.0
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) uniform writeonly image2D img;
void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    imageStore(img, c, vec4(0.0, 0.5, 1.0, 1.0)); // (B,G,R,A) 语义
}
